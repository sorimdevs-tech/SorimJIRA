# Server Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration (Leave DB_HOST empty to use local SQLite)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=flowsyncdb
# DB_USERNAME=root
# DB_PASSWORD=password
# DATABASE_URL=sqlite:///./db/flowsyncdb.db

# JWT Security
JWT_SECRET=supersecretkey-change-this-in-production-for-jwt-signing-12345
JWT_EXPIRATION_MS=604800000
JWT_REFRESH_EXPIRATION_MS=2592000000

# App Settings
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://jira-tool-1.onrender.com

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=
