# Server Configuration
PORT=8000
HOST=0.0.0.0

# JWT Security
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars-long
JWT_EXPIRATION_MS=604800000
JWT_REFRESH_EXPIRATION_MS=2592000000

# App Settings
FRONTEND_URL=https://your-app-name.onrender.com
ALLOWED_ORIGINS=https://your-app-name.onrender.com,http://localhost:3000

# SMTP Email Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
MAIL_USERNAME=sorimdevs@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password

# AI Configuration (Groq API - Optional)
AI_ENABLED=true
AI_MOCK=false
GROQ_API_KEY=
